{
  "name": "electron-starter",
  "version": "1.0.0",
  "description": "Electron + Vite starter template",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "vite build --config src/main/vite.config.ts",
    "build:preload": "vite build --config src/preload/vite.config.ts",
    "build:renderer": "vite build --config src/renderer/vite.config.ts",
    "sync-targets": "node scripts/sync-electron-targets.ts",
    "check": "biome check",
    "fix": "biome check --fix",
    "test": "vitest",
    "typecheck": "tsc --build && tsc -p tsconfig.scripts.json",
    "package": "npm run build && electron-builder",
    "init": "node scripts/init.ts",
    "shadcn": "node scripts/shadcn.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@biomejs/biome": "^2.6.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "lefthook": "^2.2.4",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
